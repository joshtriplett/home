#!/bin/bash
set -euo pipefail

if [ $# -eq 1 ]; then
    f="$1"
else
    echo "Usage: hours [file]"
    exit 1
fi
if ! [ -r "$f" ]; then
    echo "Error reading $f"
    exit 1
fi
echo "Reading hours from $f"

printf '\n=== Dates ===\n'
cat "$f" | awk '{print $1}'
printf '\n=== Descriptions ===\n'
cat "$f" | sed 's/[^(]*(//;s/)$//'
printf '\n=== Hours ===\n'
cat "$f" | sed -Ene 's/^[^ ]* ([0-9]+)h([0-9]+)m.*/\1 \2/p; s/^[^ ]* ([0-9]+)h.*/\1 0/p; s/^[^ ]* ([0-9]+)m.*/0 \1/p' | awk 'BEGIN { total=0 } { t=$1 + $2/60; total+=t; print t } END { print "\nTotal hours:", total }'

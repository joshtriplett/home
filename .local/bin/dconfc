#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

if [ "$#" -ne 1 ] || [ "${1#/}" = "$1" ]; then
    echo "Usage: dconfc PATH" >&2
    exit 1
fi

if [ "${1%/}" != "$1" ]; then
    dconf dump "$1" | dconfe dconf load "$1"
else
    value="$(dconf read "$1")"
    dconfe dconf write "$1" "$value"
fi
dconf reset -f "$1"
